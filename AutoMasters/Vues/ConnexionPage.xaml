<?xml version="1.0" encoding="utf-8" ?>
<!-- x:Class relie cette vue à ConnexionPage.xaml.cs -->
<!-- x:DataType="vm:ConnexionVueModele" indique le ViewModel utilisé pour les Bindings -->
<!-- BackgroundColor="#10080B" définit la couleur de fond sombre de la page -->
<!-- Shell.NavBarIsVisible="False" masque la barre de navigation du haut sur l'écran de connexion -->
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:AutoMasters.VuesModeles"
    x:Class="AutoMasters.Vues.ConnexionPage"
    x:DataType="vm:ConnexionVueModele"
    BackgroundColor="#10080B"
    Shell.NavBarIsVisible="False"
    Title="Connexion">

    <!-- ScrollView permet de faire défiler la page si l'écran est trop petit -->
    <ScrollView>
        <!-- VerticalStackLayout empile les éléments verticalement les uns sous les autres -->
        <!-- Padding="28,40" ajoute une marge intérieure (28 à gauche/droite, 40 en haut/bas) -->
        <!-- Spacing="18" laisse un espace de 18 pixels entre chaque élément -->
        <!-- VerticalOptions="Center" et HorizontalOptions="Center" centrent le bloc au milieu de l'écran -->
        <!-- MaximumWidthRequest="420" limite la largeur maximale du formulaire sur PC -->
        <VerticalStackLayout
            Padding="28,40"
            Spacing="18"
            VerticalOptions="Center"
            MaximumWidthRequest="420"
            HorizontalOptions="Center">

            <!-- Logo AutoMasters -->
            <!-- Stroke="#E63946" : couleur rouge de la bordure -->
            <!-- StrokeThickness="2" : épaisseur de la bordure (2 pixels) -->
            <!-- WidthRequest="72" et HeightRequest="72" : largeur et hauteur du carré (72x72 pixels) -->
            <!-- HorizontalOptions="Center" : centre le cadre horizontalement -->
            <!-- StrokeShape="RoundRectangle 16" : arrondit les 4 coins avec un rayon de 16 -->
            <!-- BackgroundColor="#221215" : couleur de fond à l'intérieur du cadre -->
            <Border
                Stroke="#E63946"
                StrokeThickness="2"
                WidthRequest="72"
                HeightRequest="72"
                HorizontalOptions="Center"
                StrokeShape="RoundRectangle 16"
                BackgroundColor="#221215">
                <!-- FontSize="34" : taille de l'icône, centrée horizontalement et verticalement dans le cadre -->
                <Label
                    Text="🏎️"
                    FontSize="34"
                    HorizontalOptions="Center"
                    VerticalOptions="Center" />
            </Border>

            <!-- Titre de l'application -->
            <!-- HorizontalTextAlignment="Center" : centre le texte -->
            <!-- CharacterSpacing="2" : espace légèrement les lettres entre elles -->
            <!-- FormattedString avec plusieurs Span permet d'écrire AUTO en blanc et MASTERS en rouge dans le même Label -->
            <!-- FontAttributes="Bold" : met le texte en gras -->
            <Label HorizontalTextAlignment="Center" CharacterSpacing="2">
                <Label.FormattedText>
                    <FormattedString>
                        <Span Text="AUTO" TextColor="#FFFFFF" FontAttributes="Bold" FontSize="26" />
                        <Span Text=" " />
                        <Span Text="MASTERS" TextColor="#E63946" FontAttributes="Bold" FontSize="26" />
                    </FormattedString>
                </Label.FormattedText>
            </Label>

            <!-- Sous-titre de la page -->
            <!-- Margin="0,-8,0,12" : marge extérieure (rapproche le texte du titre en haut de 8px et laisse 12px en bas) -->
            <Label
                Text="Collecte · Échange · Compétition"
                FontSize="12"
                TextColor="#A0A0A0"
                CharacterSpacing="1"
                HorizontalTextAlignment="Center"
                Margin="0,-8,0,12" />

            <!-- Champ de saisie de l'identifiant -->
            <VerticalStackLayout Spacing="6">
                <Label
                    Text="IDENTIFIANT"
                    FontSize="11"
                    FontAttributes="Bold"
                    TextColor="#A0A0A0"
                    CharacterSpacing="1" />
                <!-- Border qui entoure la zone de texte (Entry) avec une bordure fine (StrokeThickness="1") et des coins arrondis (RoundRectangle 10) -->
                <Border
                    Stroke="#331A20"
                    StrokeThickness="1"
                    BackgroundColor="#1E1014"
                    StrokeShape="RoundRectangle 10"
                    HeightRequest="50"
                    Padding="14,0">
                    <!-- Entry : zone de saisie reliée à la propriété Identifiant du ViewModel (Text="{Binding Identifiant}") -->
                    <!-- Placeholder : texte d'aide affiché en gris tant que le champ est vide -->
                    <!-- ClearButtonVisibility="WhileEditing" : affiche une petite croix pour effacer le texte pendant la saisie -->
                    <Entry
                        Text="{Binding Identifiant}"
                        Placeholder="Identifiant (ex: alice)"
                        PlaceholderColor="#666666"
                        TextColor="#FFFFFF"
                        Keyboard="Text"
                        ClearButtonVisibility="WhileEditing"
                        VerticalOptions="Center" />
                </Border>
            </VerticalStackLayout>

            <!-- Champ de saisie du mot de passe -->
            <VerticalStackLayout Spacing="6">
                <Label
                    Text="MOT DE PASSE"
                    FontSize="11"
                    FontAttributes="Bold"
                    TextColor="#A0A0A0"
                    CharacterSpacing="1" />
                <Border
                    Stroke="#331A20"
                    StrokeThickness="1"
                    BackgroundColor="#1E1014"
                    StrokeShape="RoundRectangle 10"
                    HeightRequest="50"
                    Padding="14,0">
                    <!-- IsPassword="True" : remplace les caractères tapés par des points pour cacher le mot de passe -->
                    <Entry
                        Text="{Binding MotDePasse}"
                        Placeholder="••••••••••••"
                        PlaceholderColor="#666666"
                        TextColor="#FFFFFF"
                        IsPassword="True"
                        ClearButtonVisibility="WhileEditing"
                        VerticalOptions="Center" />
                </Border>
            </VerticalStackLayout>

            <!-- Bouton de connexion -->
            <!-- CornerRadius="12" : arrondit les angles du bouton -->
            <!-- IsEnabled="{Binding EstDisponible}" : désactive le bouton pendant que la connexion est en cours -->
            <!-- Command="{Binding SeConnecterCommand}" : exécute la méthode SeConnecterAsync() du ViewModel au clic -->
            <Button
                Text="SE CONNECTER"
                FontAttributes="Bold"
                FontSize="15"
                TextColor="#FFFFFF"
                BackgroundColor="#E63946"
                CornerRadius="12"
                HeightRequest="52"
                IsEnabled="{Binding EstDisponible}"
                Command="{Binding SeConnecterCommand}" />

            <!-- ActivityIndicator : roue de chargement animée -->
            <!-- IsRunning et IsVisible="{Binding EstOccupe}" : tourne et s'affiche uniquement pendant l'appel à l'API -->
            <ActivityIndicator
                Color="#E63946"
                IsRunning="{Binding EstOccupe}"
                IsVisible="{Binding EstOccupe}"
                HeightRequest="36" />

            <!-- Message d'erreur -->
            <!-- LineBreakMode="WordWrap" : renvoie automatiquement le texte à la ligne s'il est long -->
            <!-- IsVisible="{Binding AUnMessage}" : n'affiche ce Label que s'il y a un message d'erreur -->
            <Label
                Text="{Binding Message}"
                TextColor="#E63946"
                FontSize="13"
                HorizontalTextAlignment="Center"
                LineBreakMode="WordWrap"
                IsVisible="{Binding AUnMessage}" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
